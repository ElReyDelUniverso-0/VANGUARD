// v443.0 LA MUDANZA A CLOUDFLARE — Workers & Pages (plan gratis).
// La casa se construye con OpenNext (@opennextjs/cloudflare) en GitHub Actions
// (.github/workflows/cloudflare.yml) y se publica como un Worker.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vanguard",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // v443.1 LA MEMORIA EN D1 — la SQLite de la casa (db/custom.db) vive en D1.
  "d1_databases": [
    { "binding": "DB", "database_name": "vanguard", "database_id": "0f521744-09b7-41cc-b8f2-236511375105" }
  ],
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "vanguard" }
  ],
  "observability": { "enabled": true }
}
