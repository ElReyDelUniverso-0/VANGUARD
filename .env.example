# VANGUARD — variables de entorno
# Copia este archivo como ".env" y ajusta lo que necesites:
#   Windows:      copy .env.example .env
#   Mac/Linux:    cp .env.example .env

# Base de datos (SQLite incluida en la carpeta db/ del proyecto)
DATABASE_URL=file:../db/custom.db

# URL pública de tu sitio (SEO, sitemap y tarjeta al compartir en redes).
# Ponla cuando tengas tu dominio, por ejemplo:
# NEXT_PUBLIC_SITE_URL=https://vanguard.world

# Opcional — Bot de Telegram (solo si vas a usarlo)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# ─── v204.0 EL ESCUDO — seguridad (recomendado definir TODAS en Vercel) ───
# Secreto que firma las cookies de sesión (cualquier texto largo y al azar).
# AUTH_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
# Contraseña de la cuenta DUEÑO (si no se define, usa la de reserva del código).
# OWNER_PASSWORD=tu-contrasena-de-dueno
# Clave de moderación del panel de contribuciones (opcional: con sesión DUEÑO basta).
# VANGUARD_ADMIN_KEY=una-clave-larga-solo-tuya
# Secreto del webhook de Telegram (opcional: solo si usas el bot).
# TELEGRAM_WEBHOOK_SECRET=otro-texto-largo-y-aleatorio

# ─── v207.0 INFINITO — auto-actualización ───
# URL del deploy hook de Vercel (Settings → Git → Deploy Hooks → Create Hook).
# Con ella definida, Vanguard MIRA sola el repo y lanza su redeploy cuando
# hay versión nueva: push → Vanguard se reconstruye y despliega ella misma.
# VERCEL_DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/...
